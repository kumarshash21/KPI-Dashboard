# Optional: put nginx in front for HTTPS and a friendly hostname (e.g. https://dashboard.yourcompany.com)
# Save as /etc/nginx/conf.d/sf-dashboard.conf, adjust server_name + certificate paths, then: sudo nginx -t && sudo systemctl reload nginx
server {
    listen 80;
    server_name dashboard.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name dashboard.example.com;
    ssl_certificate     /etc/ssl/certs/dashboard.crt;
    ssl_certificate_key /etc/ssl/private/dashboard.key;

    location / {
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 180s;     # first load runs ~20 Salesforce queries
    }
}
