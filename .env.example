# Copy to .env (cp .env.example .env), fill in, then: chmod 600 .env
# Never commit, email or upload the real .env.

# Salesforce Connected App (OAuth 2.0 Client Credentials)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_INSTANCE_URL=https://greyorangeorg.my.salesforce.com
SF_API_VERSION=v60.0

# Optional: password-protect the dashboard (HTTP Basic login). Leave blank for no login.
DASH_USER=
DASH_PASSWORD=
